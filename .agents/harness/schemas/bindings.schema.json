{ "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "reins/bindings@2", "type": "object",
  "required": ["schema"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "reins/bindings@2" },
    "mode": { "enum": ["single", "multi"] },
    "audit": {
      "type": "object", "additionalProperties": false,
      "properties": { "required": { "type": "boolean" } }
    },
    "default": { "$ref": "#/$defs/binding" },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": { "cli": { "type": "string", "minLength": 1 }, "use": { "type": "boolean" } }
      }
    },
    "groups": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "pl": { "$ref": "#/$defs/many" },
        "planner": { "$ref": "#/$defs/one" },
        "implementer": { "$ref": "#/$defs/one" },
        "executor": { "$ref": "#/$defs/one" },
        "advisor": { "$ref": "#/$defs/many" },
        "auditor": { "$ref": "#/$defs/one" }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object", "required": ["vendor", "model"], "additionalProperties": false,
      "properties": { "vendor": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 } }
    },
    "roleBinding": {
      "type": "object", "required": ["vendor", "model"], "additionalProperties": false,
      "properties": {
        "vendor": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 },
        "fallback": { "$ref": "#/$defs/binding" }
      }
    },
    "roles": { "type": "object", "additionalProperties": { "$ref": "#/$defs/roleBinding" } },
    "one": {
      "type": "object", "additionalProperties": false,
      "dependentRequired": { "vendor": ["model"], "model": ["vendor"] },
      "properties": {
        "vendor": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 },
        "roles": { "$ref": "#/$defs/roles" },
        "fallback": { "$ref": "#/$defs/binding" }
      }
    },
    "many": {
      "type": "object", "additionalProperties": false,
      "dependentRequired": { "vendor": ["model"], "model": ["vendor"] },
      "properties": {
        "vendor": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 },
        "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binding" } },
        "roles": { "$ref": "#/$defs/roles" },
        "fallback": { "$ref": "#/$defs/binding" }
      }
    }
  }
}
