{ "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "reins/install@1", "type": "object",
  "required": ["schema", "tier", "version"],
  "properties": {
    "schema": { "const": "reins/install@1" },
    "tier": { "enum": ["harness", "loop", "graph"] },
    "version": { "type": "string" },
    "cli": { "type": "string" },
    "mode": { "enum": ["manual", "auto"] },
    "language": { "type": "string" },
    "release": {
      "type": "object",
      "properties": {
        "docs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "check"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "check": { "enum": ["roadmap-row", "changelog-section", "mentions-version"] }
            }
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "inputs": { "type": "object", "additionalProperties": { "type": "string" } },
              "stages": { "type": "array", "minItems": 1, "items": { "enum": ["rc", "stable"] } },
              "approval": { "enum": ["npm-staged", "none"] }
            }
          }
        }
      }
    }
  } }
