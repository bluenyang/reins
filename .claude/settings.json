{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env.*.local)",
      "Read(**/.env.development)",
      "Edit(**/.env.development)",
      "Read(**/.env.production)",
      "Edit(**/.env.production)",
      "Read(**/.env.staging)",
      "Edit(**/.env.staging)",
      "Read(**/.env.test)",
      "Edit(**/.env.test)",
      "Read(**/*.env)",
      "Edit(**/*.env)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Read(**/*.properties)",
      "Edit(**/*.properties)",
      "Read(**/id_rsa)",
      "Edit(**/id_rsa)",
      "Read(**/id_rsa.*)",
      "Edit(**/id_rsa.*)",
      "Read(**/id_ed25519)",
      "Edit(**/id_ed25519)",
      "Read(**/id_ed25519.*)",
      "Edit(**/id_ed25519.*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(git push --no-verify *)"
    ]
  }
}
