{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loop state",
  "type": "object",
  "required": ["schema", "stage", "rounds", "updated"],
  "properties": {
    "schema": { "const": 1 },
    "line": { "type": ["string", "null"], "description": "version line, if the project has several" },
    "target": { "type": ["string", "null"], "description": "version, rc, or item the loop runs toward" },
    "item": { "type": ["string", "null"] },
    "stage": {
      "enum": ["idle", "analyze", "design", "work", "verify", "review", "qa", "triage", "release", "write", "escalate", "human"]
    },
    "rounds": {
      "type": "object",
      "properties": {
        "verify": { "type": "integer" },
        "review": { "type": "integer" },
        "qa": { "type": "integer" },
        "escalate": { "type": "integer" }
      }
    },
    "last_report": { "type": ["string", "null"] },
    "blocked_on": { "type": ["string", "null"], "description": "decision request path" },
    "updated": { "type": "string" }
  }
}
